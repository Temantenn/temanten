APP_NAME=Temanten
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://temanten.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=temanten
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Admin demo
ADMIN_EMAIL=admin@temanten.test
ADMIN_PASSWORD=temanten123
ADMIN_NAME="Admin Temanten"

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@temanten.test"
MAIL_FROM_NAME="${APP_NAME}"

# Theme & app settings
INVITATION_EXPIRY_DAYS=365
SIGNED_IMAGE_RATE_LIMIT=240
PUBLIC_REGISTRATION_ENABLED=false